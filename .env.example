# Supabase — get these from your Supabase project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...        # service_role key — backend only, never expose

# Frontend (Vite) — safe to expose in browser
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_... # anon/public key
VITE_APP_EMAIL=home@yourapp.app           # dummy email used for PIN login

# CORS — your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://yourapp.vercel.app

# Optional: restrict login to specific emails (comma-separated)
# Leave blank to allow any authenticated user
ALLOWED_EMAILS=you@gmail.com,home@yourapp.app

# Cron secret — used to authenticate the Vercel cron cleanup job
# Generate any random string, add to Vercel environment variables too
CRON_SECRET=your-random-secret-here
